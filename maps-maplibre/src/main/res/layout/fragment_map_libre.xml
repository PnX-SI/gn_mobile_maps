<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <fr.geonature.maps.maplibre.ui.widget.ZoomButton
        android:id="@+id/zoom_button"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <fr.geonature.maps.maplibre.ui.widget.AttributionButton
            android:id="@+id/attribution_button"
            android:layout_width="48dp"
            android:layout_height="48dp" />

        <fr.geonature.maps.maplibre.ui.widget.ScaleBarView
            android:id="@+id/scale_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="invisible" />

    </LinearLayout>

    <fr.geonature.maps.maplibre.ui.widget.MyLocationButton
        android:id="@+id/fab_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:clickable="true"
        android:focusable="true"
        app:backgroundTint="@android:color/background_light"
        app:elevation="@dimen/fab_elevation"
        app:tint="@android:color/primary_text_light" />

</FrameLayout>
